---
import { getEntry } from "astro:content";
import Education from "./Education.astro";

const intro = await getEntry("about", "intro");

const { Content } = await intro?.render();
---

<section id="about-full" class="w-full my-32 md:my-36 lg:my-40 h-full">
  <div class="flex max-w-xl mx-auto flex-col md:flex-r columns-1 md:columns-2">
    <h2
      class="text-left font-intro font-bold decoration-slate-500 text-gray-50 text-3xl"
    >
      <i class="fa-solid fa-circle-info"></i>{" "}{intro?.data.title}
    </h2>
    <div
      class="prose-lg prose-h2:text-left prose prose-invert md:[&>p]:w-[666px] flex flex-col md:flex-r m-auto py-8 items-center"
    >
      <Content />
    </div>
  </div>
</section>
