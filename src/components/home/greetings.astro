---

<section
  id="greetings"
  class="w-full py-48 flex flex-col items-center justify-center"
>
  <div class="flex max-w-xl flex-col md:flex-r columns-1 md:columns-2">
    <div class="only:flex flex-col gap-8 md:gap-4 text-left">
      <h2
        class="flex flex-col text-center md:text-left text-gray-200 font-intro font-bold md:pb-4 text-4xl lg:text-5xl"
      >
        <span>
          <span id="wave">👋</span>{" "}
          <span id="greet">Hello,{" "}</span>
        </span>
        <span
          class="test bg-[linear-gradient(rgba(112,112,112,100%),rgba(229,229,229,100%))] bg-clip-text text-transparent"
        >
          I'm Kalyan Jyoti Borah
        </span>
      </h2>
      <p
        id="description"
        class="w-full text-center md:text-left text-gray-400 text-xl leading-relaxed"
      >
        Full Stack Engineer by trade, creator by passion—building secure,
        user-first web experiences for the joy of it.
      </p>
    </div>
    <div class="flex flex-col items-center justify-center"></div>
  </div>
</section>
<script>
  import gsap from "gsap";
  import { SplitText } from "gsap/SplitText";

  gsap.registerPlugin(SplitText);

  const split = new SplitText("#description", { type: "chars, words" });

  gsap.from(split.chars, {
    y: 10,
    opacity: 0,
    duration: 0.5,
    ease: "power4",
    stagger: 0.05,
  });
</script>
