---
import { cn } from "@lib/utils.ts";
export interface Props {
  name: string;
  description: string;
  tags: string[];
  image: string;
  type:
    | "web-application"
    | "mobile-application"
    | "desktop-application"
    | "website"
    | "other";
  bgColor: string;
  link: string;
  associated: string | { company: string; link: string };
}
const { name, description, bgColor, type, tags, image, link, associated } =
  Astro.props;
const projectType = type
  .replace(/-/gm, " ")
  .split(" ")
  .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
  .join(" ");
const visibleTags = tags.slice(0, 2);
const hiddenTags = tags.slice(2);
---

<div
  class="max-w-[20rem] w-full dark:bg-white/10 cursor-pointer overflow-hidden rounded-xl transition-shadow hover:shadow-sm"
>
  <a href={link} class="w-full">
    <div class="relative h-48 w-full overflow-hidden">
      <div class={cn("absolute  inset-0 text-white", bgColor)}>
        <div class="flex items-stretch justify-center h-full">
          <span class="self-center text-3xl font-bold">
            {name.toUpperCase()}
          </span>
        </div>
      </div>
    </div>
    <div class="flex flex-col gap-2 p-3">
      <div class="flex flex-col">
        <h3 class="text-base font-medium">{name}</h3>
        <h5 class="text-muted-foreground text-xs font-medium">{projectType}</h5>
      </div>
      <p class="line-clamp-3 text-sm">
        {description}
      </p>
      <div class="mt-1 mb-1.5 flex flex-row items-center gap-2">
        {
          visibleTags.map((tag) => (
            <div class="bg-card dark:bg-muted-foreground/20 rounded-full px-1.5 py-[3px] text-[10px] font-medium whitespace-nowrap md:px-2.5 md:text-xs">
              {tag}
            </div>
          ))
        }
        {
          hiddenTags.length > 0 && (
            <div
              title={hiddenTags.join(", ")}
              class="bg-card dark:bg-muted-foreground/20 rounded-full px-1.5 py-[3px] text-[10px] font-medium whitespace-nowrap md:px-2.5 md:text-xs"
            >
              + {hiddenTags.length} more
            </div>
          )
        }
      </div>
    </div>
  </a>
</div>
