---
import { cn } from "@lib/utils.ts";
export interface Props {
  name: string;
  description: string;
  tags: string[];
  image: string;
  github?: string;
  type:
    | "web-application"
    | "mobile-application"
    | "desktop-application"
    | "website"
    | "other"
    | (string & {});
  bgColor: string;
  link: string;
  associated: string | { company: string; link: string };
}
const {
  name,
  description,
  bgColor,
  type,
  tags,
  image,
  link,
  associated,
  ...props
} = Astro.props;
const projectType = type
  .replace(/-/gm, " ")
  .split(" ")
  .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
  .join(" ");
const visibleTags = tags.slice(0, 3);
const hiddenTags = tags.slice(3);
---

<div
  class="flex gap-x-4 first:mt-4 last:mb-0 mb-2 text-muted-foreground items-center"
>
  <div class="self-start">
    <div class="flex items-center gap-x-2">
      <h3
        class="font-semibold text-neutral-700 hover:text-neutral-500 text-base"
      >
        <a href={link} title={`Visit ${name}`} target="_blank">{name}</a>
      </h3>
      <div class="text-[60%] inline text-muted bg-muted-foreground px-1">
        {projectType}
      </div>
    </div>
    <p class="line-clamp-2 text-sm">{description}</p>
    <div class="max-w-full space-x-1">
      {
        visibleTags.map((tag) => (
          <div class="text-[80%] inline border px-1">{tag}</div>
        ))
      }
      <div class="text-[80%] inline border px-1">+ {hiddenTags.length}</div>
    </div>
    <div>
      <a
        href={`https://github.com/kalyan-velu/${props.github}`}
        target="_blank"
        title=`Source Code of ${name}`
        class={cn(
          "group hover:text-background",
          props.github ? "inline-block" : "hidden",
        )}
      >
        <iconify-icon icon="prime:github" width="1.7em" height="1.7em"
        ></iconify-icon>
      </a>
    </div>
  </div>
</div>
