---
import { cn } from "@lib/utils.ts";
export interface Props {
  id?: string;
  class?: string;
  title?: string;
  titleClasses?: string;
  headingTag?: "h1" | "h2" | "h3";
}
const { headingTag: Tag = "h2", ...props } = Astro.props;
---

<section
  id={props.id}
  class={cn(
    "w-full max-w-4xl mx-auto px-5 md:px-8 lg:px-10 first-of-type:mt-8",
    props.class,
  )}
>
  {
    props.title ? (
      <Tag
        class={cn(
          "font-semibold first-letter:underline md:mt-7 mt-5 mb-2 md:mb-4 text-neutral-700 tracking-wider text-xl",
          props.titleClasses,
        )}
      >
        {props.title}
      </Tag>
    ) : undefined
  }
  <slot />
</section>
