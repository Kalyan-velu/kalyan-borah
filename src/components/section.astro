---
import { cn } from "@lib/utils.ts";
export interface Props {
  id?: string;
  class?: string;
  title?: string;
  titleClasses?: string;
  headingTag?: "h1" | "h2" | "h3";
}
const { headingTag: Tag = "h2", ...props } = Astro.props;
---

<section
  id={props.id}
  class={cn("bg-white/80 px-2.5 first-of-type:mt-8 md:px-0", props.class)}
>
  {
    props.title ? (
      <Tag
        class={cn(
          "font-semibold md:mt-7 mt-5 mb-2 md:mb-4 text-neutral-700 tracking-wider text-xl",
          props.titleClasses,
        )}
      >
        {props.title}
      </Tag>
    ) : undefined
  }
  <slot />
</section>
