---
import CustomTag from "@components/CustomTag.astro";
---

<section
  id="greetings"
  class="w-full px-4 min-h-[calc(100vh-6rem)] flex flex-col items-center justify-center"
>
  <div class="flex max-w-xl flex-col md:flex-r columns-1 md:columns-2">
    <div class="only:flex flex-col gap-8 md:gap-6 text-left">
      <h2
        aria-label="Hello. I am Kalyan Jyoti Borah. Welcome to my portfolio."
        class="flex flex-col text-center font-intro font-bold md:pb-4 text-4xl lg:text-5xl"
      >
        <span>
          <span id="wave">👋</span>{" "}
          <span
            id="greet"
            class="bg-zinc-800 dark:bg-[linear-gradient(rgba(112,112,112,100%),rgba(229,229,229,100%))] bg-clip-text text-transparent"
            >Hello,{" "}</span
          >
        </span>
        <span
          class="test bg-zinc-800 dark:bg-[linear-gradient(rgba(112,112,112,100%),rgba(229,229,229,100%))] bg-clip-text text-transparent"
        >
          I'm Kalyan Jyoti Borah
        </span>
      </h2>
      <p
        id="description"
        aria-label="A Full Stack Developer by trade, creator by passion—building secure,
        user-first web experiences for the joy of it."
        class="w-full text-center text-zinc-400 text-xl mt-4 leading-relaxed"
      >
        A Full Stack Developer by trade, creator by passion—building secure,
        user-first web experiences for the joy of it.
      </p>
    </div>
    <div class="flex flex-col mt-10 items-center justify-center">
      <CustomTag
        as="a"
        target="_blank"
        aria-label="Contact Me to Discuss a Project."
        href="mailto:kalyanborah456@gmail.com?subject=Enquiry&body=Hey+Kalyan%2C+I+would+like+to+discuss+a+project+with+you.+-PortfolioEnquiry"
        id="cta"
        size="lg"
        class="rounded-xl transition-transform ease-in-out active:scale-95"
      >
        Let's Work Together
        <iconify-icon icon="tabler:rocket" height="20" width="20"
        ></iconify-icon>
      </CustomTag>
    </div>
  </div>
</section>
