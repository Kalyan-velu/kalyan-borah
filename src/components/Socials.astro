---
import socials from "@data/socials.json";
import type { Social } from "@scripts/types.ts";
---

<div class="flex flex-col fixed left-3 md:left-8 bottom-0 items-center gap-5">
  <ul class="flex flex-col gap-5">
    {
      socials.map(
        (social): Social => (
          <li title={social.name}>
            <a
              href={social.url}
              aria-label={`${social.name} link`}
              target="_blank"
              class="social-link hover:animate-spin"
            >
              <i
                class={`text-zinc-500 hover:text-zinc-600 fa-brands fa-${social.logo} fa-lg`}
              />
            </a>
          </li>
        ),
      )
    }
  </ul>
  <div class="w-[1px] h-12 dark:bg-zinc-500 bg-background"></div>
</div>
