---
import CustomTag from "@components/CustomTag.astro";
import { cn } from "@lib/utils.ts";
export interface Props {
  className?: string;
}
const className = cn(
  "rounded-full fixed z-50 translate-all delay-150 right-4 top-4 p-2",
  Astro.props.className,
);
---

<CustomTag
  as="button"
  title="Toggle Theme"
  size="icon"
  id="toggle-theme"
  aria-label="Toggle Theme"
  class={className}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="30"
    height="30"
    viewBox="0 0 24 24"
    ><path
      data-toggle-type="path"
      fill="currentColor"
      stroke="currentColor"
      d="M11.38 2.019a7.5 7.5 0 1 0 10.6 10.6C21.662 17.854 17.316 22 12.001 22C6.477 22 2 17.523 2 12c0-5.315 4.146-9.661 9.38-9.981"
    ></path>
  </svg>
</CustomTag>

