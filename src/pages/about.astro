---
import { getCollection, render } from "astro:content";
import Layout from "@layouts/Layout.astro";
import { cn } from "@lib/utils.ts";
import Section from "@components/section.astro";
import { Image } from "astro:assets";
import skillsData from "@data/skills.json";
import educationData from "@data/education.json";
import certificationsData from "@data/certifications.json";
import socials from "@data/socials.json";
import type { Social } from "@scripts/types.ts";

const entry = await getCollection("about");
const { Content } = await render(entry[0]);

const { skills } = skillsData;
interface Skill {
  name: string;
  imageUrl: string;
  color: string;
  rgbColor: string;
  type: "hard" | "soft";
  isExpert?: boolean;
}

const title = "About Kalyan Jyoti Borah | Software Engineer in Assam";
const description =
  "Learn more about Kalyan Jyoti Borah, a full stack software engineer and freelancer from Assam, India. Discover his journey, professional experience at A to Z Debug, and passion for building quality websites and software.";
const permalink = "https://kalyanjyotiborah.pro/about";
const ograph = "";

const formatSkillName = (name: string) => {
  const specials: Record<string, string> = {
    js: "JavaScript",
    html: "HTML",
    css: "CSS",
    mongoDB: "MongoDB",
    next: "Next.js",
    nodejs: "Node.js",
    postgre: "PostgreSQL",
    framerMotion: "Framer Motion",
    githubActions: "GitHub Actions",
    mysql: "MySQL",
    graphql: "GraphQL",
    github: "GitHub",
    gitlab: "GitLab",
    typescript: "TypeScript",
    nestjs: "NestJS",
  };
  return specials[name] || name.charAt(0).toUpperCase() + name.slice(1);
};
---

<Layout {title} {description} {permalink} {ograph}>
  <script src="https://www.googletagmanager.com/gtag/js?id=G-PK4HB89SDH"
  ></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag("js", new Date());

    gtag("config", "G-PK4HB89SDH");
  </script>
  <section class="relative bg-[#111] rounded-b-[2.5rem] md:rounded-b-[4rem] min-h-[40vh] flex flex-col justify-center px-5 md:px-10 pt-28 pb-14 overflow-hidden text-center text-white">
    <div class="z-10 mt-6">
      <h1 class="font-bebas halftone-text text-6xl md:text-8xl uppercase leading-none">ABOUT ME</h1>
      <p class="text-neutral-400 text-[10px] md:text-xs uppercase tracking-[0.25em] mt-3">My story, philosophy, and experience</p>
    </div>
  </section>

  <Section class="mt-8 md:mt-12">
    <div
      class="mt-0 px-4 md:px-0 
      [&>h2]:text-xl [&>h2]:md:text-2xl [&>h2]:font-semibold [&>h2]:text-neutral-800 [&>h2]:tracking-wider [&>h2]:first-letter:underline [&>h2]:mt-10 [&>h2]:mb-4
      [&>h3]:text-base [&>h3]:md:text-lg [&>h3]:font-bold [&>h3]:text-neutral-800 [&>h3]:mt-6 [&>h3]:mb-1 [&>h3]:uppercase [&>h3]:tracking-wider
      [&>p]:text-base [&>p]:font-light [&>p]:text-neutral-600 [&>p]:leading-relaxed [&>p]:mb-4
      [&>ul]:list-disc [&>ul]:pl-5 [&>ul]:space-y-2 [&>ul]:mb-6
      [&>ul>li]:text-base [&>ul>li]:font-light [&>ul>li]:text-neutral-600 [&>ul>li]:leading-relaxed
      [&>ol]:list-decimal [&>ol]:pl-5 [&>ol]:space-y-2 [&>ol]:mb-6
      [&>ol>li]:text-base [&>ol>li]:font-light [&>ol>li]:text-neutral-600 [&>ol>li]:leading-relaxed
      [&>hr]:border-neutral-200 [&>hr]:my-10"
    >
      <Content />
      <div class="mt-8">
        <a
          href="https://drive.google.com/file/d/1s0JZw1setqmVjWizVOHigxm_ANEk6zOy/view?usp=sharing"
          target="_blank"
          class="inline-flex items-center gap-x-2 px-4 py-2 bg-neutral-800 text-white rounded-lg hover:bg-neutral-700 transition-colors text-base font-medium"
        >
          <iconify-icon icon="lucide:file-text" width="18" height="18"
          ></iconify-icon>
          Download Resume
        </a>
      </div>
    </div>
  </Section>

  <Section title="Hard Skills" id="skills">
    <div class="flex flex-wrap gap-2 mt-4">
      {
        skills
          .filter((skill) => skill.type === "hard")
          .map((skill) => (
            <div class="flex items-center gap-x-2 px-3 py-1.5 bg-white border border-neutral-200 rounded-md shadow-sm hover:shadow-md transition-shadow duration-300">
              {skill.imageUrl.startsWith("/") ? (
                <Image
                  height={20}
                  width={20}
                  src={skill.imageUrl}
                  alt={skill.name}
                  class="object-contain"
                  loading="lazy"
                />
              ) : (
                <iconify-icon
                  icon={skill.imageUrl}
                  width="20"
                  height="20"
                  style={`color: ${skill.color}`}
                />
              )}
              <span class="text-base font-medium text-neutral-600">
                {formatSkillName(skill.name)}
              </span>
            </div>
          ))
      }
    </div>
  </Section>

  <Section title="Soft Skills">
    <div class="flex flex-wrap gap-2 mt-4">
      {
        skills
          .filter((skill) => skill.type === "soft")
          .map((skill) => (
            <div class="flex items-center gap-x-2 px-3 py-1.5 bg-white border border-neutral-200 rounded-md shadow-sm hover:shadow-md transition-shadow duration-300">
              {skill.imageUrl.startsWith("/") ? (
                <Image
                  height={20}
                  width={20}
                  src={skill.imageUrl}
                  alt={skill.name}
                  class="object-contain"
                  loading="lazy"
                />
              ) : (
                <iconify-icon
                  icon={skill.imageUrl}
                  width="20"
                  height="20"
                  style={`color: ${skill.color}`}
                />
              )}
              <span class="text-base font-medium text-neutral-600">
                {formatSkillName(skill.name)}
              </span>
            </div>
          ))
      }
    </div>
  </Section>

  <Section title="Education">
    <div class="flex flex-col gap-y-6 mt-4">
      {
        [...educationData].reverse().map((edu) => (
          <div class="border-l-2 border-neutral-200 pl-4 relative">
            <div class="absolute w-3 h-3 bg-neutral-300 rounded-full -left-[7px] top-1.5 border-2 border-white" />
            <h3 class="text-lg font-semibold text-neutral-800">{edu.name}</h3>
            <p class="text-base text-neutral-500 font-medium">
              {edu.institute}
              {edu.university ? `, ${edu.university}` : ""}
            </p>
            <div class="flex justify-between items-center mt-1 text-base">
              <span class="text-neutral-600 italic">
                {edu.from} - {edu.to}
              </span>
              <span class="font-bold text-neutral-700">
                {edu.percentage}%
              </span>
            </div>
            <p class="text-base text-neutral-400 mt-1">{edu.address}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section title="Certifications">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
      {
        certificationsData.map((cert) => (
          <div class="p-4 border border-neutral-100 rounded-lg bg-neutral-50/50 hover:bg-white hover:shadow-sm transition-all">
            <h3 class="text-base font-semibold text-neutral-800 leading-tight">
              {cert.title}
            </h3>
            <p class="text-base text-neutral-600 mt-1">{cert.issuer}</p>
            <div class="flex items-center justify-between mt-3 text-base">
              <span class="text-neutral-400">{cert.issued}</span>
              {cert.credentialID && (
                <span class="text-sm px-1.5 py-0.5 bg-neutral-100 text-neutral-500 rounded font-mono">
                  {cert.credentialID.substring(0, 10)}...
                </span>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </Section>
</Layout>
