---
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
import ProjectCard from "@components/project-card.astro";
import { Image } from "astro:assets";
import Section from "@components/section.astro";
import Socials from "@components/Socials.astro";
import socials from "@data/socials.json";
import type { Social } from "@scripts/types.ts";
import skillsData from "@data/skills.json";

const { skills } = skillsData;
interface Skill {
  name: string;
  imageUrl: string;
  color: string;
  rgbColor: string;
}

const formatSkillName = (name: string) => {
  const specials: Record<string, string> = {
    js: "JavaScript",
    html: "HTML",
    css: "CSS",
    mongoDB: "MongoDB",
    next: "Next.js",
    nodejs: "Node.js",
    postgre: "PostgreSQL",
    framerMotion: "Framer Motion",
    githubActions: "GitHub Actions",
    mysql: "MySQL",
    graphql: "GraphQL",
    github: "GitHub",
    gitlab: "GitLab",
    typescript: "TypeScript",
  };
  return specials[name] || name.charAt(0).toUpperCase() + name.slice(1);
};

const allProjects = await getCollection("projects");
const projects = allProjects
  .filter((p) => p.data.status === "completed")
  .sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const onGoingProjects = allProjects
  .filter((p) => p.data.status === "ongoing")
  .sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const title = "Kalyan Jyoti Borah | Software Engineer & Freelancer in Assam";
const description =
  "Portfolio of Kalyan Jyoti Borah, a full stack software engineer and freelancer based in Assam, India. Specializing in building performant websites and applications. Formerly at A to Z Debug.";
const permalink = "https://kalyanjyotiborah.pro/";
const ograph = "";
---

<Layout {title} {description} {permalink} {ograph}>
  <script src="https://www.googletagmanager.com/gtag/js?id=G-PK4HB89SDH"
  ></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag("js", new Date());

    gtag("config", "G-PK4HB89SDH");
  </script>
  <Section id="overview" class="bg-white/80 px-2.5 md:px-0">
    <div
      class="flex-col-reverse flex md:flex-row gap-y-4 md:gap-y-0  mt-2 px-0"
    >
      <div class="flex flex-col basis-3/4">
        <h1 class="text-lg  font-semibold text-neutral-800">
          A software engineer and freelancer from Sivasagar, Assam, India. I
          specialize in building high-quality websites and software that help
          both clients and users.
        </h1>
        <p class="text-sm my-2 tracking-wide text-neutral-600">
          I have <b>two(2) years of experience</b> building full stack applications.
          My last working place was <b>A to Z Debug (2023 - 2025)</b>, where I
          was developing and delivering amazing products using <b>React</b>, <b
            >Next JS</b
          >, <b>NodeJS</b> and <b>ExpressJs</b> etc.
          <br />
          Outside of my office hours you will find me <a
            href="https://github.com/kalyan-velu"
            class="underline">building hobby projects</a
          >, listening to music and reading blogs. Currently expanding my skill
          set to include backend systems and system design.
            <br/>
          <strong>I am actively seeking freelance or full-time opportunities and available to start immediately.</strong>
        </p>
      </div>
      <div
        class="relative flex-1  items-start selt-start justify-center flex basis-1/4 overflow-hidden"
      >
        <Image
          loading="eager"
          alt="Kalyan Jyoti Borah - Software Engineer and Freelancer in Assam"
          height={186}
          width={128}
          class="w-32 h-44 rounded-xl object-cover"
          src="/pic.jpg"
        />
      </div>
    </div>
  </Section>
  <Section title="Socials">
    <ul class='flex flex-wrap gap-5'>
      {socials.map((social):Social => (
        <li title={social.name}>
          <a href={social.url} aria-label={`${social.name} link`} target="_blank" class='social-link hover:animate-spin'>
            <iconify-icon class=`text-zinc-500 hover:text-zinc-600` icon={social.logo} width="24" height="24"/>
          </a>
        </li>
      ))
      }
    </ul>
  </Section>
 
    <Section title="Projects I'm Proud Of" id="overview-works">
    {
      projects
        .slice(0, 2)
        .map((project) => (
          <ProjectCard
            {...project.data}
            link={`/works/${project.slug}`}
            slug={project.slug}
          />
        ))
    }
    {
      projects.length > 2 ? (
        <div class="text-sm font-medium underline underline-offset-2 flex items-center justify-center">
          <a href="/works">View More</a>
        </div>
      ) : undefined
    }
  </Section>
  <Section title="What I am working on" id="overview-current">
    {
      onGoingProjects
        .slice(0, 2)
        .map((project) => (
          <ProjectCard
            {...project.data}
            link={`/works/${project.slug}`}
            slug={project.slug}
          />
        ))
    }
    {
      onGoingProjects.length > 2 ? (
        <div class="text-sm font-medium underline underline-offset-2 flex items-center justify-center">
          <a href="/works">View More</a>
        </div>
      ) : undefined
    }
  </Section>
  <Section title="Skills" id="skills" class="mb-8">
    <div class="flex flex-wrap gap-2">
      {
        skills.map((skill: Skill) => (
          <div class="flex items-center gap-x-2 px-2 py-1 bg-white border border-neutral-200 rounded-md shadow-sm hover:shadow-md transition-shadow duration-300">
            <Image
              height={20}
              width={20}
              src={skill.imageUrl}
              alt={skill.name}
              class="object-contain"
              loading="lazy"
            />
            <span class="text-xs font-medium text-neutral-600">
              {formatSkillName(skill.name)}
            </span>
          </div>
        ))
      }
    </div>
  </Section>
</Layout>
