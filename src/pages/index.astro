---
import Greetings from "@components/greetings.astro";
import Layout from "@layouts/Layout.astro";
import projects from "@data/projects.json";
import onGoingProjects from "@data/ongoingProjects.json";
import ProjectCard from "@components/project-card.astro";
import CustomTag from "@components/CustomTag.astro";
import Section from "@components/section.astro";
const title = "Kalyan Jyoti Borah";
const description = "The Homepage of Kalyan Jyoti Borah\'s Portfolio";
const permalink = "";
const ograph = "";
---

<Layout {title} {description} {permalink} {ograph}>
  <script src="https://www.googletagmanager.com/gtag/js?id=G-PK4HB89SDH"
  ></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag("js", new Date());

    gtag("config", "G-PK4HB89SDH");
  </script>
  <Section id="overview" class="bg-white/80 px-2.5 md:px-0">
    <div
      class="flex-col-reverse flex md:flex-row gap-y-4 md:gap-y-0 items-center mt-2 px-0"
    >
      <div class="flex flex-col basis-3/4">
        <h2>
          A full stack developer/engineer from a small village from Sivasagar,
          Assam, India. With a passion to build tools and product that helps
          both clients and users.
        </h2>
        <p class="text-sm my-2 tracking-wide text-neutral-600">
          I have <b>two(2) years of experience</b> building full stack applications.
          My last working place was <b>A to Z Debug (2023 - 2025)</b>, where I
          was developing and delivering amazing products using <b>React</b>, <b
            >Next JS</b
          >, <b>NodeJS</b> and <b>ExpressJs</b> etc,. Mostly frontend focused work
          with little bit of backend work.
          <br />
          Outside of my office hours you will find me <a
            href="https://github.com/kalyan-velu"
            class="underline">building hobby projects</a
          >,listening to music and reading blogs. Currently expanding my skill
          set to have backend system and system design skills.
        </p>
      </div>
      <div
        class="relative flex-1 items-center justify-center flex basis-1/4 overflow-hidden"
      >
        <img
          loading="eager"
          alt="Kalyan"
          class="w-32 h-44 rounded-xl object-cover object-[0rem_-1.6rem]"
          src="/pic.jpg"
        />
      </div>
    </div>
  </Section>
  <Section title="Works (Completed)" id="overview-works">
    {
      projects
        .slice(0, 2)
        .map((project) => (
          <ProjectCard
            associated={project.associated}
            bgColor={project.bgColor}
            description={project.description}
            image={project.image}
            link={project.link}
            name={project.name}
            tags={project.tags}
            type={project.type}
            github={project.github}
          />
        ))
    }
    {
      projects.length > 2 ? (
        <div class="text-sm font-medium underline underline-offset-2 flex items-center justify-center">
          <a href="/works">View More</a>
        </div>
      ) : undefined
    }
  </Section>
  <Section title="What I am working on" id="overview-current">
    {
      onGoingProjects
        .slice(0, 2)
        .map((project) => (
          <ProjectCard
            associated={project.associated}
            bgColor={project.bgColor}
            description={project.description}
            image={project.image}
            link={project.link}
            name={project.name}
            tags={project.tags}
            type={project.type}
            github={project.github}
          />
        ))
    }
    {
      onGoingProjects.length > 2 ? (
        <div class="text-sm font-medium underline underline-offset-2 flex items-center justify-center">
          <a href="/works">View More</a>
        </div>
      ) : undefined
    }
  </Section>
</Layout>
