</Layout>
<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@300;400;500;700&display=swap");

  :root {
    --bg-dark: #111;
    --bg-light: #f5f5f5;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    font-family: "Space Grotesk", sans-serif;
    margin: 0;
    padding: 0;
    overflow-x: hidden;
  }

  .font-bebas {
    font-family: "Bebas Neue", cursive;
  }

  /* Mobile-first: solid white, upgrade to halftone on larger screens */
  .halftone-text {
    display: inline-block;
    line-height: 0.9;
    color: #ffffff;
  }

  @media (min-width: 640px) {
    .halftone-text {
      background-image: radial-gradient(circle, #fff 1px, transparent 1.5px);
      background-size: 3.5px 3.5px;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
  }

  /* Hero heading fluid size */
  .hero-heading {
    font-size: clamp(3.5rem, 8vw, 13rem);
    letter-spacing: -0.01em;
  }

  /* CTA heading fluid size */
  .cta-heading {
    font-size: clamp(2.8rem, 10vw, 7rem);
  }

  .pill-button {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.5rem;
    border-radius: 9999px;
    font-weight: 500;
    transition: all 0.3s ease;
    cursor: pointer;
    text-decoration: none;
  }

  .pill-button:hover {
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.25);
  }

  .outline-button {
    padding: 0.25rem 1rem;
    border-radius: 0.25rem;
    border: 1px solid rgba(0, 0, 0, 0.2);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: transparent;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .outline-button:hover {
    background: black;
    color: white;
  }

  /* Floating icon base — hidden on mobile */
  .floating-icon {
    position: absolute;
    opacity: 0.25;
    transition: all 0.5s ease;
    filter: grayscale(1) brightness(2);
    display: none;
  }

  @media (min-width: 768px) {
    .floating-icon {
      display: block;
    }

    .floating-icon:hover {
      opacity: 1;
      filter: grayscale(0) brightness(1);
      transform: scale(1.25);
    }
  }

  /* Individual floating icon positions & sizes */
  .floating-icon--aws {
    top: 12%;
    left: 8%;
    font-size: 2.5rem;
  }

  .floating-icon--docker {
    top: 35%;
    right: 12%;
    font-size: 3rem;
  }

  .floating-icon--wordpress {
    bottom: 22%;
    left: 12%;
    font-size: 2.5rem;
  }

  .floating-icon--github {
    top: 18%;
    right: 28%;
    font-size: 2rem;
  }

  .floating-icon--sparkles {
    bottom: 38%;
    right: 8%;
    font-size: 1.8rem;
    opacity: 0.8;
    filter: none;
    color: #facc15;
  }

  .floating-icon--settings {
    top: 58%;
    left: 4%;
    font-size: 1.8rem;
  }

  /* Small inline icon (arrow, etc.) */
  .icon-xs {
    font-size: 0.85rem;
  }

  /* Small white icon inside filled circles */
  .icon-sm-white {
    color: white;
    font-size: 0.9rem;
  }

  .service-section {
    background-color: var(--bg-light);
    color: black;
  }

  .case-studies-section {
    background-color: black;
    border-radius: 2rem;
    margin: 0 0.75rem;
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .case-studies-section {
      border-radius: 4rem;
      margin: 0 1rem;
    }
  }

  .case-studies-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at center,
      rgba(255, 255, 255, 0.05) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .gsap-reveal {
    will-change: transform, opacity;
  }
</style>
