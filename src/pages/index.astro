const title = "Kalyan Jyoti Borah";
const description = "The Homepage of Kalyan Jyoti Borah's Portfolio";
const permalink = "";
const ograph = "";
---

<Layout {title} {description} {permalink} {ograph}>
  <!-- <Goog></Goog>le tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-PK4HB89SDH"
  ></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag("js", new Date());

    gtag("config", "G-PK4HB89SDH");
  </script>
  <ShortIntro />
  <section class="container mx-auto"></section>
</Layout>
