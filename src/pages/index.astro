---
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Services from '@components/home/services.astro';
import Workflow from '@components/home/workflow.astro';
import CTA from '@components/CTA.astro';
import Footer from '@components/footer.astro';
import Approach from '@components/home/approach.astro';
import FeaturedProjects from '@components/home/featured-projects.astro';
import ClientBenefits from '@components/home/ClientBenefits.astro';

const title =
  'Freelance Software Engineer in Assam, India | Kalyan – Website Developer Sivasagar & Guwahati';
const description =
  'Kalyan Jyoti Borah is a freelance software engineer and website developer based in Sivasagar, Assam, India. Available for freelance projects in Guwahati, Assam, and globally. Custom websites, software engineering, and scalable solutions for businesses. Most trusted Website Design, Mobile App, Web Application Development, eCommerce, SEO developer in Assam.';
const permalink = 'https://kalyanjyotiborah.pro/';
const keywords =
  'freelance developer sivasagar, website, software engineer assam, website developer guwahati, freelance software engineer india, web developer sivasagar, hire freelance developer assam, kalyan jyoti borah, website developer assam, software developer North East Asia, freelance web developer guwahati, custom software development assam,';
---

<Layout {title} {description} {permalink} {keywords}>
  <section
    class="relative bg-[#111] rounded-b-[2.5rem] md:rounded-b-[4rem] min-h-[95vh] flex flex-col px-5 md:px-10 pt-24 md:pt-32 pb-14 overflow-hidden"
  >
    <div
      class="flex-1 flex flex-col items-center justify-center text-center relative z-10 mt-8 md:mt-0"
    >
      <p class="text-lg md:text-xl font-light text-foreground italic mb-3 opacity-85">
        Hi, I am Kalyan.
      </p>
      <h1 class="font-bebas halftone-text hero-heading uppercase">
        SOFTWARE<br />ENGINEER
      </h1>
      <p
        class="mt-5 text-neutral-400 text-[10px] md:text-sm uppercase tracking-[0.18em] md:tracking-[0.3em] max-w-xs md:max-w-none"
      >
        Freelance Website Developer &amp; Full-Stack Systems Engineer
      </p>
    </div>

    <div class="max-w-xl mx-auto text-center mt-10 z-10">
      <p class="text-neutral-400 text-sm md:text-base leading-relaxed font-light">
        Based in Assam, India — available for freelance projects globally. I engineer
        high-performance web products that solve real business problems, load in milliseconds, and
        remain maintainable as your business scales.
      </p>
    </div>
  </section>
  <Services />
  <ClientBenefits />
  <FeaturedProjects />
  <Approach />
  <Workflow />
</Layout>
