---
import Layout from '@layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Section from '@components/section.astro';
import ProjectCarousel from '@components/carousel/ProjectCarousel.astro';
import { getEntry, render } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;

const data = await getEntry('projects', project.id);
if (data === undefined) {
  return Astro.redirect('/404');
}
const { Content } = await render(data);
const title = `${project.data.name} | Project by Kalyan Jyoti Borah`;
const description = `${project.data.description} - A project developed by Kalyan Jyoti Borah, a software engineer and freelancer in Assam.`;
const permalink = `https://kalyanjyotiborah.pro/works/${project.id}`;
const ograph = project.data.image;
---

<Layout {title} {description} {permalink} {ograph}>
  <section
    class="relative bg-[#111] rounded-b-[2.5rem] md:rounded-b-[4rem] min-h-[40vh] flex flex-col justify-center px-5 md:px-10 pt-28 pb-14 overflow-hidden text-center text-white"
  >
    <div class="z-10 mt-6">
      <h1
        class="font-bebas halftone-text text-5xl md:text-7xl uppercase leading-none"
        transition:name={`${project.id}-title`}
      >
        {project.data.name}
      </h1>
      <p class="text-neutral-400 text-[10px] md:text-xs uppercase tracking-[0.25em] mt-3">
        {project.data.type.replace('-', ' ')} • {project.data.status}
      </p>
    </div>
  </section>

  <Section id="project-detail" class="mt-8 md:mt-12">
    <div class="mb-8">
      <a
        href="/works"
        class="text-sm underline underline-offset-4 hover:text-neutral-600 transition-colors"
      >
        ← Back to Works
      </a>
    </div>

    <div class="flex flex-col gap-y-6">
      <div class="flex flex-wrap gap-2">
        {
          project.data.tags.map((tag) => (
            <span class="px-2 py-0.5 text-xs border rounded-md bg-neutral-50 text-neutral-600">
              {tag}
            </span>
          ))
        }
      </div>

      {
        project.data.images && project.data.images.length > 0 ? (
          <ProjectCarousel images={project.data.images} alt={project.data.name} />
        ) : project.data.image && project.data.image !== '' ? (
          <div class="aspect-video w-full overflow-hidden rounded-xl border bg-neutral-100">
            <img
              src={project.data.image}
              alt={project.data.name}
              class="h-full w-full object-fit"
              transition:name={`${project.id}-image`}
            />
          </div>
        ) : undefined
      }

      <div class="flex flex-wrap gap-x-8 gap-y-4 text-sm bg-neutral-50 rounded-xl px-6 py-4">
        <div class="flex flex-col">
          <span class="text-neutral-500 font-medium">Type</span>
          <span class="text-neutral-800 capitalize">{project.data.type.replace('-', ' ')}</span>
        </div>
        <div class="flex flex-col">
          <span class="text-neutral-500 font-medium">Associated</span>
          <span class="text-neutral-800">
            {
              typeof project.data.associated === 'string' ? (
                project.data.associated
              ) : (
                <a href={project.data.associated.link} target="_blank" class="underline">
                  {project.data.associated.company}
                </a>
              )
            }
          </span>
        </div>
        {
          project.data.link && (
            <div class="flex flex-col">
              <span class="text-neutral-500 font-medium">Live</span>
              <a href={project.data.link} target="_blank" class="text-neutral-800 underline">
                Visit Project
              </a>
            </div>
          )
        }
        {
          project.data.github && (
            <div class="flex flex-col">
              <span class="text-neutral-500 font-medium">Source</span>
              <a
                href={`https://github.com/kalyan-velu/${project.data.github}`}
                target="_blank"
                class="text-neutral-800 underline"
              >
                GitHub
              </a>
            </div>
          )
        }
      </div>

      <article
        class="prose prose-neutral max-w-none text-neutral-700
        prose-headings:text-neutral-800 prose-headings:font-bold
        prose-h2:text-xl prose-h2:mt-8 prose-h2:mb-4
        prose-p:mb-4 prose-p:leading-relaxed
        prose-ul:list-disc prose-ul:pl-5 prose-ul:mb-4
        prose-li:mb-1"
      >
        <Content />
      </article>
    </div>
  </Section>
</Layout>
