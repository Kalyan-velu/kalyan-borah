---
import Layout from "@layouts/Layout.astro";

const title = "Inquiry Received | Kalyan Jyoti Borah";
const description = "Thank you for reaching out. I have received your message and will get back to you within 24 hours.";
const permalink = "https://kalyanjyotiborah.pro/success";
---

<Layout {title} {description} {permalink}>
  <section class="min-h-[80vh] flex flex-col items-center justify-center px-5 text-center text-black">
    <div class="max-w-md w-full bg-neutral-55 border border-neutral-150 p-8 rounded-2xl shadow-sm flex flex-col items-center">
      <div class="w-16 h-16 bg-neutral-900 text-white rounded-full flex items-center justify-center mb-6">
        <iconify-icon icon="lucide:check" width="32" height="32"></iconify-icon>
      </div>
      
      <h1 class="font-bebas text-5xl mb-4 text-neutral-800 leading-tight">THANK YOU!</h1>
      
      <p class="text-neutral-600 text-sm font-light leading-relaxed mb-8">
        Your inquiry has been successfully submitted. I have received your details and will review them shortly. You can expect a response within 24 hours.
      </p>
      
      <a 
        href="/" 
        class="pill-button bg-black text-white text-xs uppercase tracking-widest hover:bg-neutral-800 font-semibold inline-flex items-center gap-x-2 py-3 px-8 transition-colors"
      >
        <iconify-icon icon="lucide:arrow-left" width="16" height="16"></iconify-icon>
        Back to Home
      </a>
    </div>
  </section>
</Layout>
