---
import BaseHead, {
  type Props as BaseHeadProps,
} from "@components/BaseHead.astro";
import Socials from "@components/Socials.astro";
export type Props = BaseHeadProps;
---

<!doctype html>
<html lang="en" class="light">
  <BaseHead {...Astro.props} />
  <body
    class="dark:bg-background scheme-only-light bg-foreground text-background dark:text-foreground"
  >
    <noscript>
      <iframe
        src="https://www.googletagman;ager.com/ns.html?id=GTM-P3ZGF3GZ"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <main class="min-h-dvh max-w-2xl w-full mx-auto relative">
      <nav
        class="flex justify-between px-2 md:px-0 items-center-safe flex-no-wrap"
      >
        <a
          href="/"
          title="Overview of Kalyan Jyoti Borah"
          class="py-4 text-xl md:text-2xl">Kalyan J. Borah's</a
        >
        <div
          class="text-sm gap-x-2.5 flex items-center text-muted-foreground [&>a]:hover:text-background [&>a]:cursor-pointer] [&>a]:select-none"
        >
          <a href="/about">About</a>
          <a href="/works">Works</a>
          <a href="/experiences">Experience</a>
        </div>
      </nav>
      <slot />
      <!--<Socials />-->
    </main>
  </body>
</html>
