---
import BaseHead, {
  type Props as BaseHeadProps,
} from "@components/BaseHead.astro";
import Socials from "@components/Socials.astro";
import StackedNavigation from "@components/stacked-navigation.astro";
import ToggleTheme from "@components/ToggleTheme.astro";
export interface Props extends BaseHeadProps {}
---

<!doctype html>
<html lang="en" class="">
  <BaseHead {...Astro.props} />
  <body
    class="dark:bg-background bg-foreground text-background dark:text-foreground"
  >
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-P3ZGF3GZ"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <main class="min-h-dvh relative w-full">
      <a
        download="https://drive.google.com/file/d/1W-n6AucXTmftFXGd_DEipijMxpXo8DHd/view?usp=sharing"
        class="border-background dark:border-foreground bg-primary text-foreground border fixed left-0 z-50 top-4 border-l-0 rounded-lg rounded-l-none py-1 self-end px-3 pr-2 md:py-1.5 md:px-4 md:pr-3 text-sm cursor-pointer flex gap-2 items-center"
        target="_blank"
        aria-label="View Resume"
        href="https://drive.google.com/file/d/1W-n6AucXTmftFXGd_DEipijMxpXo8DHd/view?usp=sharing"
      >
        <i class="fa-regular fa-file-pdf"></i> View Resume
      </a>
      <ToggleTheme />
      <!--<StackedNavigation />-->
      <slot />
      <Socials />
    </main>
    <slot name="morph-svg-plugin" />
  </body>
</html>
