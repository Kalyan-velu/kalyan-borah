---
import BaseHead, {
  type Props as BaseHeadProps,
} from "@components/BaseHead.astro";
import Socials from "@components/Socials.astro";
import { cn } from "@lib/utils.ts";

export interface Props extends BaseHeadProps {}
const { title, description, permalink, keywords } = Astro.props;

const { pathname } = Astro.url;
const isActive = (path: string) =>
  pathname === path || pathname.startsWith(`${path}/`);
---

<!doctype html>
<html lang="en" class="light">
  <BaseHead {title} {description} {permalink} {keywords} />
  <body
    class="dark:bg-background scheme-only-light bg-foreground text-background dark:text-foreground"
  >
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-P3ZGF3GZ"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <main class="min-h-dvh w-full mx-auto relative">
      <slot />
    </main>
  </body>
</html>
